import { useState } from "react";
import axios from "axios";
import "./App.css";

function App() {
  const [prompt, setPrompt] = useState("");
  const [memeImageUrl, setMemeImageUrl] = useState("");
  const [loading, setLoading] = useState(false);

  const handleGenerate = async () => {
    if (!prompt) return;

    setLoading(true);
    try {
      const response = await axios.post("http://localhost:5000/generate-meme", { prompt });
      setMemeImageUrl(response.data.memeImageUrl);
    } catch (error) {
      console.error(error);
      alert("Failed to generate meme!");
    } finally {
      setLoading(false);
    }
  };

  const handleDownload = () => {
    if (!memeImageUrl) return;
    const link = document.createElement("a");
    link.href = memeImageUrl;
    link.download = "venky-meme.png";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  return (
    <div className="container">
      <h1 className="floating-title">Venky Meme Gener@tor 🎉</h1>
      <div className="input-area">
        <input
          type="text"
          value={prompt}
          onChange={(e) => setPrompt(e.target.value)}
          placeholder="Enter your funny meme idea..."
          className="colorful-input"
        />
        <button onClick={handleGenerate} className="colorful-button">
          {loading ? "Generating..." : "Generate Meme"}
        </button>
      </div>

      {memeImageUrl && (
        <div className="preview-area">
          <h2>Preview:</h2>
          <img src={memeImageUrl} alt="Generated Meme" className="meme-preview" />
          <button onClick={handleDownload} className="colorful-button download-button">
            Download Meme
          </button>
        </div>
      )}
    </div>
  );
}

export default App;
